# Yandex Metrika counter id (cookie banner appears only when set)
VITE_YM_ID=

# HTTPS endpoint that accepts POST application/json AnalyticsPayload
# See docs/analytics.md for a Google Apps Script / Sheet example
VITE_ANALYTICS_INGEST_URL=

# Адрес размещения (по умолчанию — боевой stp-multiframe.ru/problemomer/). См. docs/DEPLOY.md
# VITE_BASE_PATH=/problemomer/
# VITE_SITE_URL=https://stp-multiframe.ru/problemomer/

# Ссылка калькулятора (кнопка и QR в PDF). По умолчанию https://stp-multiframe.ru/calc/
# VITE_CALCULATOR_URL=https://stp-multiframe.ru/calc/
